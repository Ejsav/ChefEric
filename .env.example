# Public canonical origin — used for metadata, sitemap, and JSON-LD.
# Leave empty on Vercel until the real domain is live; the project's
# production address is used automatically.
NEXT_PUBLIC_SITE_URL=

# Public contact inbox and Instagram handle (without @). Hidden while empty.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM=

# The builder behind the template (attribution, structured data) and an
# optional scheduling link (Cal.com, Calendly) shown on /your-site.
NEXT_PUBLIC_BUILDER_URL=
NEXT_PUBLIC_BOOKING_URL=

# ── Lead delivery (lib/leads.ts) ────────────────────────────────────────
# Website requests (and, on a customer's site, chef requests) are delivered
# to every configured channel. On a Vercel PRODUCTION deployment at least one
# channel must be set, or the form tells visitors it could not deliver.
#
# Email via Resend (https://resend.com). The sender domain must be verified.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
# Older names, still read as fallbacks:
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
#
# Optional: also POST each lead as JSON to a CRM, Zapier/Make, a Slack
# workflow or a sheet. When a secret is set, the body is signed:
#   X-Lead-Signature: sha256=<HMAC-SHA256 of the raw body>
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Signs private invitation links (/invite/<token>). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVITE_SECRET=

# Optional: Plausible Analytics domain (Vercel Analytics works with no config on Vercel).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
